# .env.example — copy to .env and fill in; never commit .env to version control
#
# All live-data credentials live here.  The prediction code never imports from
# this file directly — values are read via the broker adapter in src/data/live.py.

# ── Upstox (Phase 1 primary broker) ──────────────────────────────────────────
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:8000/callback
UPSTOX_ACCESS_TOKEN=           # populated at runtime after OAuth flow

# ── Dhan (active — primary historical data source) ───────────────────────────
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here
DHAN_ADJUSTMENT_STATUS=adjusted

# ── Ollama narrator (Phase 5) ─────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b         # fallback: qwen2.5:3b

# ── Optional macro / news APIs (Phase 1) ─────────────────────────────────────
# Add free-tier keys here as they are wired in.
